@@ -749,6 +749,7 @@ _NVS_SRC = r'''// agent2 nvs: native verify-SLIDING attention (L 8, G 8, D 64, H
 #define NV_PREGS 40
 #define NV_CREGS 160
 #define NV_MINB 1
+#define NV_BN2 1
 #include <torch/extension.h>
 #include <c10/cuda/CUDAStream.h>
 #include <cuda_bf16.h>
@@ -1116,6 +1117,105 @@ __device__ __forceinline__ void consumer(Smem<NS>& sm, int h, const __nv_bfloat1
         fence_regs(o);
         newdone = true;
     }
+#if NV_BN2
+    // Consumer steps of 2 stages (128 keys): one max / shuffle / alpha / rescale per 128 keys. A missing second tile
+    // (n odd) reuses the first one's stage and is masked out (P = 0), so every wgmma issues unconditionally.
+    if (n > 0) {
+        float sA[32], sB[32];
+        uint32_t qa2[16], qb2[16];
+#define S2(k) ((k) < 32 ? sA[(k)] : sB[(k) - 32])
+        auto qk2 = [&](int t0) {
+            const int a0 = t0 % NS, a1 = t0 + 1 < n ? (t0 + 1) % NS : a0;
+            mb_wait(&sm.ready[a0], (t0 / NS) & 1);
+            if (t0 + 1 < n) mb_wait(&sm.ready[a1], ((t0 + 1) / NS) & 1);
+            const uint32_t ka = smem_u32(&sm.k[a0][0]) + h * 64, kb = smem_u32(&sm.k[a1][0]) + h * 64;
+            wg_fence();
+            qk_k32(sA, mdesc(qa, 512, 2), mdesc(ka, 1024, 1), 0);
+            qk_k32(sA, mdesc(qa + 32, 512, 2), mdesc(ka + 32, 1024, 1), 1);
+            qk_k32(sB, mdesc(qa, 512, 2), mdesc(kb, 1024, 1), 0);
+            qk_k32(sB, mdesc(qa + 32, 512, 2), mdesc(kb + 32, 1024, 1), 1);
+            wg_commit();
+        };
+        auto pv2 = [&](const uint32_t (&pin)[16], int t0) {
+            const int a0 = t0 % NS, a1 = t0 + 1 < n ? (t0 + 1) % NS : a0;
+            const uint32_t va = smem_u32(&sm.vt[a0][h][0]), vb = smem_u32(&sm.vt[a1][h][0]);
+            wg_fence();
+            pv8_k32(o, pin[0], pin[1], pin[2], pin[3], mdesc(va, 512, 2));
+            pv8_k32(o, pin[4], pin[5], pin[6], pin[7], mdesc(va + 32, 512, 2));
+            pv8_k32(o, pin[8], pin[9], pin[10], pin[11], mdesc(vb, 512, 2));
+            pv8_k32(o, pin[12], pin[13], pin[14], pin[15], mdesc(vb + 32, 512, 2));
+            wg_commit();
+        };
+        auto rel2 = [&](int t0) {
+            if (lane == 0) {
+                mb_arrive(&sm.empty[t0 % NS]);
+                if (t0 + 1 < n) mb_arrive(&sm.empty[(t0 + 1) % NS]);
+            }
+        };
+        auto sm2 = [&](uint32_t (&pout)[16], int t0) {
+            const int nv = hi - lo - t0 * BN;
+            if (nv < 2 * BN || thr + 1 - t0 * BN > 0) { mask(sA, lane, nv, thr - t0 * BN); mask(sB, lane, nv - BN, thr - (t0 + 1) * BN); }
+            float mx0 = S2(0), mx1 = S2(2);
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+                mx0 = fmaxf(mx0, fmaxf(S2(j * 4 + 0), S2(j * 4 + 1)));
+                mx1 = fmaxf(mx1, fmaxf(S2(j * 4 + 2), S2(j * 4 + 3)));
+            }
+            mx0 = fmaxf(mx0, __shfl_xor_sync(0xffffffff, mx0, 1));
+            mx1 = fmaxf(mx1, __shfl_xor_sync(0xffffffff, mx1, 1));
+            mx0 = fmaxf(mx0, __shfl_xor_sync(0xffffffff, mx0, 2));
+            mx1 = fmaxf(mx1, __shfl_xor_sync(0xffffffff, mx1, 2));
+            const float mn0 = fmaxf(m[0], mx0 * scale), mn1 = fmaxf(m[1], mx1 * scale);
+            alpha[0] = ex2(m[0] - mn0); alpha[1] = ex2(m[1] - mn1);
+            m[0] = mn0; m[1] = mn1;
+            const float o0 = mn0 - 8.f, o1 = mn1 - 8.f;
+            float l0 = 0.f, l1 = 0.f;
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+                S2(j * 4 + 0) = ex2(fmaf(S2(j * 4 + 0), scale, -o0)); S2(j * 4 + 1) = ex2(fmaf(S2(j * 4 + 1), scale, -o0));
+                S2(j * 4 + 2) = ex2(fmaf(S2(j * 4 + 2), scale, -o1)); S2(j * 4 + 3) = ex2(fmaf(S2(j * 4 + 3), scale, -o1));
+                l0 += S2(j * 4 + 0) + S2(j * 4 + 1); l1 += S2(j * 4 + 2) + S2(j * 4 + 3);
+            }
+#pragma unroll
+            for (int kk = 0; kk < 4; ++kk) {
+                const int b0 = 16 * kk;
+                pout[kk * 4 + 0] = pack_e4(S2(b0 + 0), S2(b0 + 1), S2(b0 + 4), S2(b0 + 5));
+                pout[kk * 4 + 1] = pack_e4(S2(b0 + 2), S2(b0 + 3), S2(b0 + 6), S2(b0 + 7));
+                pout[kk * 4 + 2] = pack_e4(S2(b0 + 8), S2(b0 + 9), S2(b0 + 12), S2(b0 + 13));
+                pout[kk * 4 + 3] = pack_e4(S2(b0 + 10), S2(b0 + 11), S2(b0 + 14), S2(b0 + 15));
+            }
+            l[0] = l[0] * alpha[0] + l0; l[1] = l[1] * alpha[1] + l1;
+        };
+        qk2(0);
+        wg_wait<0>();
+        fence_regs(sA); fence_regs(sB);
+        sm2(qa2, 0);
+        if (newdone) { rescale(o, alpha); fence_regs(o); }
+        auto step2 = [&](uint32_t (&pin)[16], uint32_t (&pout)[16], int t0) {
+            qk2(t0);
+            fence_regs(pin);
