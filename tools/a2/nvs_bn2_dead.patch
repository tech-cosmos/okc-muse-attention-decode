+            wg_wait<1>();
+            fence_regs(sA); fence_regs(sB);
+            sm2(pout, t0);
+            wg_wait<0>();
+            fence_regs(o);
+            rel2(t0 - 2);
+            rescale(o, alpha);
+            fence_regs(o);
+        };
+        int t = 2;
+        for (; t + 2 < n; t += 4) { step2(qa2, qb2, t); step2(qb2, qa2, t + 2); }
+        uint32_t (&pl)[16] = qa2;
+        if (t < n) { step2(qa2, qb2, t); t += 2; fence_regs(qb2); pv2(qb2, t - 2); }
+        else { fence_regs(qa2); pv2(qa2, t - 2); }
+        (void)pl;
+#undef S2
+        wg_wait<0>();
+        fence_regs(o);
+        rel2(t - 2);
+    }
+#else
     if (n > 0) {
         mb_wait(&sm.ready[0], 0);
         issue_qk(s, qa, smem_u32(&sm.k[0][0]) + h * 64);
@@ -1153,6 +1253,7 @@ __device__ __forceinline__ void consumer(Smem<NS>& sm, int h, const __nv_bfloat1
         for (; i + 1 < n; i += 2) { step(pa, pb, i); step(pb, pa, i + 1); }
         if (i < n) { step(pa, pb, i); last(pb); } else last(pa);
     }
+#endif
     l[0] += __shfl_xor_sync(0xffffffff, l[0], 1); l[0] += __shfl_xor_sync(0xffffffff, l[0], 2);
     l[1] += __shfl_xor_sync(0xffffffff, l[1], 1); l[1] += __shfl_xor_sync(0xffffffff, l[1], 2);
     const long long part = (((long long)b * 2 + h) * S + split) * MR;
