+@triton.jit
+def _combine_fl(qkv_ptr, pacc_ptr, pml_ptr, vs_ptr, out_ptr, fl_ptr, mc_ptr,
+                HQ: tl.constexpr, HKV: tl.constexpr, G: tl.constexpr, D: tl.constexpr, S: tl.constexpr,
+                S_PAD: tl.constexpr, SB: tl.constexpr, NP: tl.constexpr, NAP: tl.constexpr = 0):
+    """_combine for decode (_gd_full) without waiting for the whole attention grid: slot chunks are merged
+    (online) as soon as their programs' ready flags reach this call's count. Each merge program counts its own
+    calls in mc_ptr; each attention program bumps its own flag once per call, so after n calls all are n."""
+    b = tl.program_id(0)
+    head = tl.program_id(1)
+    h = head // G
+    QKV_W: tl.constexpr = (2 * HQ + 2 * HKV) * D
+    d = tl.arange(0, D)
+    gate = tl.load(qkv_ptr + b * QKV_W + (HQ + 2 * HKV) * D + head * D + d).to(tl.float32)
+    mc = mc_ptr + b * HQ + head
+    want = tl.load(mc) + 1
+    fl = fl_ptr + (b * (HKV // 2) + h // 2) * NP
+    row = (b * HKV + h) * S * G + head % G
+    sb = tl.arange(0, SB)
+    m_i = tl.full([1], -1.0e30, tl.float32)
+    l_i = tl.zeros([1], tl.float32)
+    acc = tl.zeros([D], tl.float32)
+    for i in tl.static_range(0, S_PAD, SB):
+        si = i + sb
+        ok = si < S
+        prog = tl.minimum(si, NP - 1)
+        while tl.min(tl.where(ok, tl.load(fl + prog, mask=ok, other=0, volatile=True), want), 0) < want:
+            if NAP == 1:
+                tl.inline_asm_elementwise("nanosleep.u32 100;", "=r", [], dtype=tl.int32, is_pure=False, pack=1)
+            if NAP == 2:
+                tl.inline_asm_elementwise("nanosleep.u32 500;", "=r", [], dtype=tl.int32, is_pure=False, pack=1)
+        tl.inline_asm_elementwise("fence.acq_rel.gpu;", "=r", [], dtype=tl.int32, is_pure=False, pack=1)
+        m = tl.load(pml_ptr + (row + si * G) * 2, mask=ok, other=-1.0e30, cache_modifier=".cg")
+        l = tl.load(pml_ptr + (row + si * G) * 2 + 1, mask=ok, other=0.0, cache_modifier=".cg")
+        a = tl.load(pacc_ptr + (row + si * G)[:, None] * D + d[None, :], mask=ok[:, None], other=0.0,
+                    cache_modifier=".cg")
+        m_new = tl.maximum(m_i, tl.max(m, 0))
+        alpha = tl.exp2(m_i - m_new)
+        w = tl.exp2(m - m_new)
+        l_i = l_i * alpha + tl.sum(w * l, 0)
+        acc = acc * alpha + tl.sum(w[:, None] * a, 0)
+        m_i = m_new
+    o = acc / l_i * tl.load(vs_ptr)
+    o = o * tl.rsqrt(tl.sum(o * o, 0) / D + 1e-5)
+    tl.store(out_ptr + b * HQ * D + head * D + d, (o * tl.sigmoid(gate)).to(tl.bfloat16))
+    tl.store(mc, want)
+    # Done only after the attention grid (as with a wait at the start).
+    gdc_wait()
+
